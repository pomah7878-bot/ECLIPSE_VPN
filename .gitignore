# Unignore specific files
!README.MD
!.gitignore

# Explicitly ignore these (redundant due to * but good for clarity/overrides if I change * later)
config.py
secrets.env
logs/
tests/
docs/
results.md
AGENTS.md
.agents/
tmp/
custom_extensions/
**/__pycache__/
.vscode

# База данных (создаётся автоматически при запуске)
database/vpn_bot.db
database/vpn_bot.db-wal
database/vpn_bot.db-shm
database/vpn_bot.db.*
database/ai_history.db*

# Локальные бэкапы (создаются автоматически планировщиком)
backup/

# Загружаемый админом брендинг (лого + автосгенерированные favicon) — НЕ
# отслеживаем в git, иначе git pull/reset при обновлении бота молча
# затирает кастомный логотип обратно на дефолтный. *.default.* — это
# сами дефолты (шаблон для новых установок), они остаются в git.
bot/webapp/static/logo.png
bot/webapp/static/favicon.ico
bot/webapp/static/favicon-32x32.png
bot/webapp/static/favicon-16x16.png

# Virtual Environment
venv/
env/
.venv/
.env/
env*/
venv*/
.env

# Локальные бэкапы, создаваемые patch-скриптами (никогда не коммитим)
*.bak
*.bak.*
**/*.bak
**/*.bak.*
database/*.db.bak*
