# Скопируйте этот файл в secrets.env и впишите реальные значения.
# secrets.env добавлен в .gitignore и никогда не попадёт в git.

GROQ_API_KEY=ваш_groq_api_key
TAVILY_API_KEY=ваш_tavily_api_key
SUPPORT_API_TOKEN=ваш_support_api_token

# OAuth-вход в личный кабинет на сайте (необязательно) — можно также
# настроить прямо в боте: Админ-панель → Настройки бота → 🌐 Интеграции
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
TURNSTILE_SITE_KEY=  # публичный sitekey Cloudflare Turnstile — ПРИВЯЗАН К ДОМЕНУ! при смене домена нужен новый ключ из кабинета Cloudflare

# Если сайт стоит за CDN (Cloudflare), укажите заголовок с настоящим IP клиента, иначе лимиты попыток
# считаются по адресу CDN, а не по клиенту. Включайте, только если nginx не пропускает этот заголовок от посторонних.
# CLIENT_IP_HEADER=CF-Connecting-IP

# --- Whitelabel-лицензия (можно не задавать: ключ вводится кнопкой «💳 Моя лицензия» в боте) ---
# LICENSE_KEY=ECLW-XXXX-XXXX-XXXX
# Открытый ключ лицензионного сервера (необязательно; иначе запоминается при первой проверке)
# LICENSE_SERVER_PUBKEY=
